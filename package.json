{
  "name": "rhythmdesk",
  "version": "0.1.0",
  "description": "A strict sit/stand posture and break enforcement desktop app for Linux",
  "main": "dist/main/main/main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:main\" \"npm run dev:renderer\" \"wait-on http://localhost:5173 && wait-on dist/main/main/main.js && env -u ELECTRON_RUN_AS_NODE electron --no-sandbox .\"",
    "dev:main": "tsc -p tsconfig.main.json --watch",
    "dev:renderer": "vite",
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "electron:dev": "npm run dev",
    "electron:build": "npm run build && electron-builder",
    "dist": "npm run build && electron-builder --linux",
    "dist:linux": "npm run build && electron-builder --linux AppImage deb",
    "dist:appimage": "npm run build && electron-builder --linux AppImage",
    "dist:deb": "npm run build && electron-builder --linux deb",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx"
  },
  "build": {
    "appId": "com.rhythmdesk.app",
    "productName": "RhythmDesk",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "resources/**/*"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources",
        "filter": [
          "**/*"
        ]
      }
    ],
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility",
      "icon": "resources/icons",
      "executableName": "rhythmdesk",
      "synopsis": "Strict sit/stand posture and break enforcement",
      "description": "RhythmDesk helps you maintain healthy work habits by enforcing sit/stand schedules, break reminders, and fullscreen overlay notifications.",
      "desktop": {
        "Name": "RhythmDesk",
        "Comment": "Sit/stand posture and break scheduler",
        "StartupWMClass": "rhythmdesk",
        "Categories": "Utility;Health;",
        "Icon": "rhythmdesk"
      },
      "maintainer": "RhythmDesk"
    }
  },
  "dependencies": {
    "electron-store": "^8.1.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@types/uuid": "^9.0.7",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "electron": "^27.3.0",
    "electron-builder": "^24.9.1",
    "electron-vite": "^5.0.0",
    "eslint": "^8.56.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.21.1",
    "sharp": "^0.34.5",
    "typescript": "^5.3.3",
    "vite": "^5.0.10",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.5",
    "wait-on": "^7.2.0"
  },
  "author": "",
  "license": "MIT"
}
